index 0000000..ed2a506
--- /dev/null
+++ b/include/mpv/frame_output.h
@@ -0,0 +1,114 @@
+/*
+ * frame_output.h — host ABI of the frame_output VO (59 vendored patch).
+ *
+ * This header is part of mpv.
+ *
+ * mpv is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * mpv is distributed in the hope that it will be useful, but
+ * WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with mpv.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+/*
+ * The frame_output video output delivers decoded frames to the host
+ * application as CVPixelBuffers instead of drawing them itself.  It is
+ * the iOS counterpart of the original MPlayKit design (a private
+ * frame_output vo feeding an AVSampleBufferDisplayLayer), restored by
+ * the AVFan Build 59 patch series; it is not part of upstream mpv.
+ *
+ * Usage:
+ *   1. The host registers a consumer for a sink name with
+ *      mp_frame_output_register() (usually before creating the player).
+ *   2. The player is created with --vo=frame_output and
+ *      --vo-frame-output-sink=<name> so the VO instance finds its
+ *      consumer.
+ *   3. For every presented frame the VO invokes the callback twice at
+ *      most: once with kind=MP_FRAME_OUTPUT_SUBTITLE (a transparent
+ *      BGRA image with the subtitle/OSD bitmaps for that frame,
+ *      rendered by mpv's own OSD layer at the subtitle render size)
+ *      and once with kind=MP_FRAME_OUTPUT_VIDEO (the video frame).
+ *      Subtitle images are only produced for non-repeat frames.
+ *
+ * Ownership: pixel_buffer is handed over with one retain owned by the
+ * callee; the consumer must CFRelease it exactly once.  For
+ * hardware-decoded (VideoToolbox) frames the buffer is the decoder's
+ * own CVPixelBuffer (zero copy); for software frames the VO packs the
+ * planes into a freshly created CVPixelBuffer.
+ *
+ * Threading: the callback runs on mpv's VO thread.  It must not block
+ * and must not call back into the client API of the same player.
+ * Retain the buffer and hand it to your own queue if processing takes
+ * time.
+ *
+ * The subtitle render size can be changed at runtime with
+ * mp_frame_output_set_subtitle_size(); it is deliberately decoupled
+ * from the video frame size (a picture-in-picture window renders its
+ * subtitles at its own render size).  0 restores "same as video".
+ */
+
+#ifndef MPV_FRAME_OUTPUT_H
+#define MPV_FRAME_OUTPUT_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum mp_frame_output_kind {
+    MP_FRAME_OUTPUT_VIDEO = 0,
+    MP_FRAME_OUTPUT_SUBTITLE = 1,
+};
+
+typedef struct mp_frame_output_info {
+    /* enum mp_frame_output_kind */
+    int kind;
+    /* CVPixelBufferRef; one retain is transferred to the callee. */
+    void *pixel_buffer;
+    /* Realtime presentation timestamp of the frame (vo_frame pts, in
+     * nanoseconds on the mp_time_ns() clock); 0 means "present as
+     * soon as possible". */
+    int64_t pts_ns;
+    /* Stream timestamp of the frame in seconds (mp_image pts);
+     * negative if the frame carries no timestamp. */
+    double pts_seconds;
+    /* Approximate frame duration in seconds; 0 if unknown. */
+    double duration_seconds;
+    int width;
+    int height;
+    /* True for repeated/redrawn frames (video kind only). */
+    int repeat;
+    /* Monotonic frame id of the video frame this delivery belongs
+     * to (vo_frame frame_id); subtitle deliveries carry the id of
+     * the video frame they were rendered for. */
+    uint64_t frame_id;
+} mp_frame_output_info;
+
+typedef void (*mp_frame_output_callback)(void *opaque,
+                                         const mp_frame_output_info *info);
+
+/* Register (or replace) the consumer for a sink name.  Returns 0 on
+ * success, -1 on invalid arguments or when the registry is full. */
+int mp_frame_output_register(const char *sink, void *opaque,
+                             mp_frame_output_callback cb);
+
+/* Remove the consumer for a sink name, if any. */
+void mp_frame_output_unregister(const char *sink);
+
+/* Set the subtitle render size override for a sink (0 = video size).
+ * Thread-safe; takes effect on the next rendered subtitle image. */
+void mp_frame_output_set_subtitle_size(const char *sink, int width, int height);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* MPV_FRAME_OUTPUT_H */
